# ========================================
# SERVER
# ========================================

# Port the Express server runs on
PORT=8001

# ========================================
# DATABASE
# ========================================

# MongoDB connection string (local or Atlas)
MONGO_URI=""

# ========================================
# AUTH
# ========================================

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=""

# ========================================
# CORS
# ========================================

# URL of the deployed frontend, allowed to call this API
# (localhost:5173 and the existing Vercel URL are already allowed by default)
FRONTEND_URL=http://localhost:5173
